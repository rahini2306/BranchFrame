region                     = "ap-south-1"
bucket_name                = "replace-with-your-globally-unique-bucket-name"
image_tag                  = "REPLACE_WITH_COMMIT_SHA"
worker_token_parameter_arn = "arn:aws:ssm:ap-south-1:123456789012:parameter/branchframe/worker-token"
