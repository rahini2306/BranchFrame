#!/bin/bash
set -euo pipefail
dnf install -y docker
systemctl enable --now docker
mkdir -p /srv/branchframe/data
chown 10001:10001 /srv/branchframe/data
TOKEN=$(aws ssm get-parameter --name '${token_arn}' --with-decryption --region '${region}' --query Parameter.Value --output text)
umask 077
cat > /srv/branchframe/app.env <<ENV
BRANCHFRAME_BUCKET=${bucket}
AWS_DEFAULT_REGION=${region}
BRANCHFRAME_WORKER_TOKEN=$TOKEN
BRANCHFRAME_SECURE_COOKIE=1
BRANCHFRAME_PUBLIC_URL=${public_url}
BRANCHFRAME_ORIGIN_SECRET=${origin_secret}
BRANCHFRAME_MAIL_PROVIDER=ses
BRANCHFRAME_MAIL_FROM=${mail_from}
BRANCHFRAME_REQUIRE_VERIFIED_EMAIL=1
ENV
unset TOKEN
cat > /etc/systemd/system/branchframe.service <<'UNIT'
[Unit]
Description=BranchFrame API
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
[Service]
Restart=always
RestartSec=20
ExecStartPre=/bin/bash -c 'aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${registry}'
ExecStartPre=/usr/bin/docker pull ${image}
ExecStartPre=-/usr/bin/docker rm -f branchframe
ExecStart=/usr/bin/docker run --name branchframe --init --security-opt no-new-privileges --env-file /srv/branchframe/app.env --log-driver awslogs --log-opt awslogs-region=${region} --log-opt awslogs-group=${log_group} --log-opt awslogs-stream=api -p 8000:8000 -v /srv/branchframe/data:/data ${image} python -m branchframe.server --host 0.0.0.0 --workers 0
ExecStop=/usr/bin/docker stop branchframe
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now branchframe
