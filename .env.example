# Local editing needs no environment variables. Export these for cloud mode.
BRANCHFRAME_DATA=data
# BRANCHFRAME_BUCKET=your-private-bucket
# AWS_DEFAULT_REGION=ap-south-1
# BRANCHFRAME_WORKER_TOKEN=generate-a-random-secret
# BRANCHFRAME_SECURE_COOKIE=1

# Real delivery: choose SES (using an AWS role) OR SMTP with STARTTLS.
# BRANCHFRAME_PUBLIC_URL=https://your-site.example
# BRANCHFRAME_MAIL_PROVIDER=ses
# BRANCHFRAME_MAIL_FROM=verified-sender@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=keep-out-of-git
# BRANCHFRAME_REQUIRE_VERIFIED_EMAIL=1
# Explicit local-only mailbox writes private JSON files under data/outbox.
# BRANCHFRAME_DEV_MAILBOX=1
# CloudFront-only deployments: a private origin header, never a public token.
# BRANCHFRAME_ORIGIN_SECRET=generated-by-terraform
